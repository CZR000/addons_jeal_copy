<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Odoo 18: el atributo ``attrs`` fue eliminado en v17. Los modificadores
        invisible/readonly/required se declaran como atributos directos con
        expresión Python.
    -->
    <record id="view_account_move_reversal_inherit_exchange_rate" model="ir.ui.view">
        <field name="name">account.move.reversal.form.inherit.exchange.rate</field>
        <field name="model">account.move.reversal</field>
        <field name="inherit_id" ref="account.view_account_move_reversal"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date']" position="after">
                <field name="exchange_rate"
                       invisible="exchange_rate == 0.0"
                       widget="float"
                       options="{'digits': [16, 6]}"/>
            </xpath>
        </field>
    </record>
</odoo>
