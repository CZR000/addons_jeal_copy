<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <record id="view_stock_request_order_inh_form" model="ir.ui.view">
            <field name="name">view.stock.request.order.inh.form</field>
            <field name="model">stock.request.order</field>
            <field name="inherit_id" ref="stock_request.stock_request_order_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='stock_request_ids']/list/field[@name='state']" position="before">
                    <field name="comment_editable" 
                        string      = "Comentario" 
                        optional    = "show" 
                        groups      = "stock_request_custom_field_permission.group_edit_comment_stock_request"/>

                    <field name="comment_readonly" 
                        string      = "Comentario" 
                        optional    = "show" 
                        readonly    = "1" 
                        groups      = "stock_request_custom_field_permission.group_view_comment_stock_request"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
