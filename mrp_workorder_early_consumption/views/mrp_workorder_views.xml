<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Odoo 18: el atributo `attrs="{...}"` fue eliminado en v17. Los
        modificadores invisible/readonly/required se declaran ahora como
        atributos directos con expresiones Python.

        El método `action_add_component()` lo provee upstream en v18:
          * `mrp_workorder/models/mrp_workorder.py:258` (delega a producción)
          * `mrp_workorder/models/mrp_production.py:36`
    -->
    <record id="mrp_workorder_form_add_component_button_woec" model="ir.ui.view">
        <field name="name">mrp.workorder.form.woec.add.component.button</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_form_view_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_add_component"
                        type="object"
                        string="Añadir componente"
                        class="btn-primary"
                        invisible="production_state in ('draft', 'done', 'cancel') or state in ('done', 'cancel')"/>
            </xpath>
        </field>
    </record>
</odoo>
