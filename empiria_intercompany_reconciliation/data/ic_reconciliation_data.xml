<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">
        <record id="ic_reconciliation_config_default" model="ic.reconciliation.config">
            <field name="name">Conciliación intercompany</field>
        </record>
    </data>

    <record id="ir_cron_ic_reconciliation_daily" model="ir.cron">
        <field name="name">Conciliación intercompany: ejecución diaria</field>
        <field name="model_id" ref="model_ic_reconciliation_run"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + relativedelta(days=1)).strftime('%Y-%m-%d 07:00:00')"/>
        <field name="active" eval="True"/>
    </record>

</odoo>
