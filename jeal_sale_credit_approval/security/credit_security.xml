<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_jeal_credit" model="ir.module.category">
        <field name="name">Crédito JE-AL</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_jeal_credit_admin" model="res.groups">
        <field name="name">Administrador de créditos</field>
        <field name="category_id" ref="module_category_jeal_credit"/>
        <field name="comment">Puede cambiar el límite de crédito de los
            clientes (con motivo obligatorio) y ver las solicitudes de
            aprobación.</field>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>
</odoo>
