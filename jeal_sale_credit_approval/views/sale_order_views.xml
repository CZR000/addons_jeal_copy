<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_credit" model="ir.ui.view">
        <field name="name">sale.order.form.jeal.credit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Botones de cabecera -->
            <xpath expr="//header" position="inside">
                <field name="jeal_requires_approval" invisible="1"/>
                <field name="jeal_approval_state" invisible="1"/>
                <button name="action_jeal_open_send_wizard" type="object"
                        string="Enviar solicitud al aprobador" class="btn-primary"
                        invisible="state not in ('draft','sent') or jeal_sale_type != 'credit' or not jeal_requires_approval or jeal_approval_state in ('pending','approved')"/>
                <button name="action_jeal_resend_request" type="object"
                        string="Reenviar solicitud"
                        invisible="jeal_approval_state not in ('rejected','expired') or not jeal_requires_approval"/>
            </xpath>

            <!-- Botón estadístico de solicitudes -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_jeal_view_requests" type="object"
                        class="oe_stat_button" icon="fa-envelope"
                        invisible="jeal_request_count == 0">
                    <field name="jeal_request_count" widget="statinfo" string="Solicitudes"/>
                </button>
            </xpath>

            <!-- Badge de estado junto al nombre -->
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <widget name="web_ribbon" title="Pendiente de aprobación" bg_color="text-bg-warning"
                        invisible="jeal_approval_state != 'pending'"/>
                <widget name="web_ribbon" title="Crédito aprobado" bg_color="text-bg-success"
                        invisible="jeal_approval_state != 'approved'"/>
                <widget name="web_ribbon" title="Crédito rechazado" bg_color="text-bg-danger"
                        invisible="jeal_approval_state != 'rejected'"/>
                <widget name="web_ribbon" title="Solicitud vencida" bg_color="text-bg-secondary"
                        invisible="jeal_approval_state != 'expired'"/>
            </xpath>

            <!-- Campo Tipo de venta -->
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="jeal_sale_type" widget="radio" options="{'horizontal': true}"/>
            </xpath>

            <!-- Recuadro de línea de crédito -->
            <xpath expr="//notebook" position="before">
                <group invisible="jeal_sale_type != 'credit'">
                    <field name="jeal_company_currency_id" invisible="1"/>
                    <div class="alert alert-warning" role="alert"
                         invisible="state not in ('draft','sent') or not jeal_requires_approval or jeal_approval_state == 'approved'">
                        <strong>Requiere aprobación de crédito.</strong>
                        Al confirmar se bloqueará y se pedirá enviar la solicitud al aprobador.
                    </div>
                    <div class="alert alert-success" role="alert"
                         invisible="state not in ('draft','sent') or jeal_approval_state != 'approved'">
                        Crédito aprobado. Puede confirmar la cotización.
                    </div>
                    <group col="5" string="Línea de crédito del cliente (S/)">
                        <field name="jeal_credit_limit"/>
                        <field name="jeal_debt_total"/>
                        <field name="jeal_credit_available"/>
                        <field name="jeal_debt_overdue"/>
                        <field name="jeal_amount_pen"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>