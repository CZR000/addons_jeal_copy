<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_credit_request_list" model="ir.ui.view">
        <field name="name">jeal.credit.approval.request.list</field>
        <field name="model">jeal.credit.approval.request</field>
        <field name="arch" type="xml">
            <list string="Solicitudes de aprobación"
                  decoration-warning="state == 'pending'"
                  decoration-success="state == 'approved'"
                  decoration-danger="state == 'rejected'"
                  decoration-muted="state == 'expired'">
                <field name="name"/>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="approver_id"/>
                <field name="amount_pen"/>
                <field name="debt_total"/>
                <field name="excess"/>
                <field name="reason_code"/>
                <field name="sent_date"/>
                <field name="expiry_date"/>
                <field name="state"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_credit_request_form" model="ir.ui.view">
        <field name="name">jeal.credit.approval.request.form</field>
        <field name="model">jeal.credit.approval.request</field>
        <field name="arch" type="xml">
            <form string="Solicitud de aprobación de crédito">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,approved,rejected,expired"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="order_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                            <field name="approver_id" readonly="1"/>
                            <field name="reason_code" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="amount_pen" readonly="1"/>
                            <field name="credit_limit" readonly="1"/>
                            <field name="debt_total" readonly="1"/>
                            <field name="debt_overdue" readonly="1"/>
                            <field name="excess" readonly="1"/>
                            <field name="sent_date" readonly="1"/>
                            <field name="expiry_date" readonly="1"/>
                            <field name="decided_date" readonly="1"/>
                        </group>
                    </group>
                    <field name="rejection_reason" readonly="1"
                           invisible="state != 'rejected'"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_credit_requests" model="ir.actions.act_window">
        <field name="name">Solicitudes de aprobación</field>
        <field name="res_model">jeal.credit.approval.request</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
