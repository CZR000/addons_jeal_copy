<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_credit_limit_wizard_form" model="ir.ui.view">
        <field name="name">jeal.credit.limit.wizard.form</field>
        <field name="model">jeal.credit.limit.wizard</field>
        <field name="arch" type="xml">
            <form string="Cambiar límite de crédito">
                <group>
                    <field name="partner_id" readonly="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="current_limit"/>
                    <field name="debt_total"/>
                    <field name="debt_overdue"/>
                    <field name="new_limit"/>
                    <field name="reason" placeholder="Motivo del cambio (obligatorio)"/>
                    <field name="new_available"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirmar"
                            class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
