<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <record id="view_hr_contract_renew_form" model="ir.ui.view">
            <field name="name">hr.contract.renew.form</field>
            <field name="model">hr.contract.renew</field>
            <field name="arch" type="xml">
                <form string="Renovación de Contratos">
                    <header>
                        <button name="action_generate_renewal_lines" string="Buscar Contratos" type="object" class="btn-primary" invisible="state != 'draft'" icon="fa-search" data-hotkey="q"/>

                        <button name="action_approve_renewals" string="Aprobar y Procesar" type="object" class="btn-primary" invisible="state != 'generated'" icon="fa-check" confirm="¿Estás seguro de que deseas aprobar este proceso? Esta acción marcará los contratos y los preparará para la renovación automática." data-hotkey="v"/>

                        <button name="button_to_draft" string="Restablecer a Borrador" type="object" class="btn-secondary" invisible="state not in ('generated', 'cancel')" icon="fa-undo" confirm="Atención: Se eliminarán todas las líneas y se restablecerá el estado. ¿Deseas continuar?" data-hotkey="r"/>

                        <button name="button_cancel" string="Cancelar Proceso" type="object" class="btn-secondary" invisible="state not in ('generated', 'processed')" icon="fa-times" confirm="¿Estás seguro de que quieres cancelar este proceso? Los contratos relacionados serán restablecidos." data-hotkey="z"/>

                        <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                    </header>

                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1" placeholder="Borrador de Renovación"/>
                            </h1>
                            <h2 invisible="state == 'draft'">
                                <field name="sequence" readonly="1"/>
                            </h2>
                        </div>

                        <group>
                            <group string="Configuración">
                                <field name="company_id" options="{'no_create': True, 'no_open': True}"/>
                            </group>

                            <group string="Rango de Vencimiento">
                                <label for="date_from" string="Fechas"/>
                                <div class="o_row">
                                    <field name="date_from" class="oe_inline"/>
                                    <i class="fa fa-long-arrow-right mx-2" aria-label="Arrow icon" title="Arrow"/>
                                    <field name="date_to" class="oe_inline"/>
                                </div>
                            </group>
                        </group>

                        <notebook>
                            <page string="Líneas de Renovación" name="renewal_lines">
                                <field name="renewal_line_ids">
                                    <list editable="bottom" create="false">
                                        <field name="to_renew" widget="boolean_toggle"/>
                                        <field name="employee_id" options="{'no_create': True}"/>
                                        <field name="current_contract_id" readonly="1"/>
                                        <field name="wage" widget="monetary" readonly="1"/>

                                        <field name="new_date_from"/>
                                        <field name="new_date_to"/>
                                        <field name="new_wage" widget="monetary"/>

                                        <field name="new_contract_id" optional="hide" readonly="1"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_hr_contract_renew_tree" model="ir.ui.view">
            <field name="name">hr.contract.renew.list</field>
            <field name="model">hr.contract.renew</field>
            <field name="arch" type="xml">
                <list string="Procesos de Renovación" decoration-info="state == 'draft'" decoration-success="state == 'processed'">
                    <field name="sequence" optional="show"/>
                    <field name="name"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'processed'" decoration-warning="state == 'generated'"/>
                </list>
            </field>
        </record>

        <record id="view_hr_contract_renew_search" model="ir.ui.view">
            <field name="name">hr.contract.renew.search</field>
            <field name="model">hr.contract.renew</field>
            <field name="arch" type="xml">
                <search string="Buscar Procesos de Renovación">
                    <field name="name" filter_domain="['|', ('name', 'ilike', self), ('sequence', 'ilike', self)]"/>
                    <field name="company_id"/>

                    <separator/>
                    <filter string="Borradores" name="filter_draft" domain="[('state','=','draft')]"/>
                    <filter string="Para Aprobar" name="filter_generated" domain="[('state','=','generated')]"/>
                    <filter string="Procesados" name="filter_processed" domain="[('state','=','processed')]"/>

                    <group expand="0" string="Agrupar por">
                        <filter string="Compañía" name="groupby_company_id" context="{'group_by': 'company_id'}"/>
                        <filter string="Estado" name="groupby_state" context="{'group_by': 'state'}"/>
                        <filter string="Mes de Inicio" name="groupby_date_from" context="{'group_by': 'date_from:month'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_view_hr_contract_renew" model="ir.actions.act_window">
            <field name="name">Renovar Contratos</field>
            <field name="res_model">hr.contract.renew</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_filter_draft': 1}</field>
            <field name="search_view_id" ref="view_hr_contract_renew_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Cree un nuevo proceso para automatizar la renovación de contratos de empleados.
                </p>
                <p>
                    Seleccione un rango de fechas y deje que el sistema busque los contratos próximos a vencer.
                </p>
            </field>
        </record>
    </data>
</odoo>
