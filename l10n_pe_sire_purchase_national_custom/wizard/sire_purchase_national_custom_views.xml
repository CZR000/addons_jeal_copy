<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <record id="view_sire_rce_report_custom_national_purchase_form" model="ir.ui.view">
            <field name="name">view.sire.rce.report.custom.national.purchase.form</field>
            <field name="model">sire.purchase.national.custom</field>
            <field name="arch" type="xml">
                <form string="Generador RCE - Compras Nacionales">
                    <div class="alert alert-danger" role="alert" invisible="not error_dialog">
                        <i class="fa fa-exclamation-triangle me-2"/>
                        <field name="error_dialog" readonly="1" nolabel="1"/>
                    </div>

                    <group>
                        <group string="Parámetros del Reporte">
                            <field name="company_id" invisible="1"/>
                            <field name="year"/>
                            <field name="month"/>
                            <field name="state_send"/>
                            <field name="opportunity_code"/>

                            <field name="correlative" invisible="opportunity_code in ('01', '02', '', False)" required="opportunity_code in ('03', '04')"/>
                        </group>

                        <group string="Archivos Generados">
                            <field name="xlsx_filename" invisible="1"/>
                            <field name="xlsx_binary" filename="xlsx_filename" readonly="1" widget="binary" invisible="not xlsx_binary"/>

                            <field name="zip_filename" invisible="1"/>
                            <field name="zip_binary" filename="zip_filename" readonly="1" widget="binary" invisible="not zip_binary"/>

                            <div class="text-muted" colspan="2" invisible="xlsx_binary or zip_binary">
                                <i class="fa fa-info-circle me-1"/>
                                Los archivos aparecerán aquí tras hacer clic en "Generar Reporte".
                            </div>
                        </group>
                    </group>

                    <footer>
                        <button string="Generar Reporte" name="action_generate_files" type="object" class="btn-primary" data-hotkey="q"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel" data-hotkey="z"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_sire_rce_report_custom_national_purchase" model="ir.actions.act_window">
            <field name="name">Reporte RCE - Compras Nacionales Personalizado</field>
            <field name="groups_id" eval="[(4, ref('account.group_account_invoice'))]"/>
            <field name="res_model">sire.purchase.national.custom</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
