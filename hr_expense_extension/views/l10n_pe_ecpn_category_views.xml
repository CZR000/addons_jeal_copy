<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_l10n_pe_ecpn_category_list" model="ir.ui.view">
        <field name="name">l10n.pe.ecpn.category.list</field>
        <field name="model">l10n.pe.ecpn.category</field>
        <field name="arch" type="xml">
            <list string="Categorías ECPN" editable="bottom">
                <field name="code"/>
                <field name="name"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_pe_ecpn_category_form" model="ir.ui.view">
        <field name="name">l10n.pe.ecpn.category.form</field>
        <field name="model">l10n.pe.ecpn.category</field>
        <field name="arch" type="xml">
            <form string="Categoría ECPN">
                <sheet>
                    <widget name="web_ribbon" title="Archivado"
                            bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_l10n_pe_ecpn_category" model="ir.actions.act_window">
        <field name="name">Categorías ECPN</field>
        <field name="res_model">l10n.pe.ecpn.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_l10n_pe_ecpn_category"
              name="Categorías ECPN"
              parent="menu_hr_expense_extension_root"
              action="action_l10n_pe_ecpn_category"
              sequence="20"/>

</odoo>
