<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_journal_form_receivable" model="ir.ui.view">
        <field name="name">account.journal.form.allow.receivable</field>
        <field name="model">account.journal</field>
        <field name="inherit_id"
               ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">

            <xpath expr="//page[@name='advanced_settings']" position="inside">
                <group string="Rendiciones / Anticipos"
                       invisible="type not in ('cash', 'bank')">
                    <field name="allow_receivable_accounts"/>
                </group>
            </xpath>

        </field>
    </record>

</odoo>
