<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Sistema de Trabajo -->
    <record id="view_hr_recruitment_work_system_list" model="ir.ui.view">
        <field name="name">hr.recruitment.work.system.list</field>
        <field name="model">hr.recruitment.work.system</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_hr_recruitment_work_system" model="ir.actions.act_window">
        <field name="name">Sistema de Trabajo</field>
        <field name="res_model">hr.recruitment.work.system</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Modalidad de Contrato -->
    <record id="view_hr_recruitment_contract_modality_list" model="ir.ui.view">
        <field name="name">hr.recruitment.contract.modality.list</field>
        <field name="model">hr.recruitment.contract.modality</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_hr_recruitment_contract_modality" model="ir.actions.act_window">
        <field name="name">Modalidad de Contrato</field>
        <field name="res_model">hr.recruitment.contract.modality</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Modalidad de Trabajo -->
    <record id="view_hr_recruitment_work_modality_list" model="ir.ui.view">
        <field name="name">hr.recruitment.work.modality.list</field>
        <field name="model">hr.recruitment.work.modality</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_hr_recruitment_work_modality" model="ir.actions.act_window">
        <field name="name">Modalidad de Trabajo</field>
        <field name="res_model">hr.recruitment.work.modality</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Menús: Configuración > Contrato > (los 3 anteriores) -->
    <menuitem id="menu_hr_recruitment_config_contract"
              name="Contrato"
              parent="hr_recruitment.menu_hr_recruitment_configuration"
              sequence="25"/>

        <menuitem id="menu_hr_recruitment_work_system"
                  name="Sistema de Trabajo"
                  parent="menu_hr_recruitment_config_contract"
                  action="action_hr_recruitment_work_system"
                  sequence="1"/>

        <menuitem id="menu_hr_recruitment_contract_modality"
                  name="Modalidad de Contrato"
                  parent="menu_hr_recruitment_config_contract"
                  action="action_hr_recruitment_contract_modality"
                  sequence="2"/>

        <menuitem id="menu_hr_recruitment_work_modality"
                  name="Modalidad de Trabajo"
                  parent="menu_hr_recruitment_config_contract"
                  action="action_hr_recruitment_work_modality"
                  sequence="3"/>

</odoo>
