<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_recruitment_stage_form_ext" model="ir.ui.view">
        <field name="name">hr.recruitment.stage.form.ext</field>
        <field name="model">hr.recruitment.stage</field>
        <field name="inherit_id" ref="hr_recruitment.hr_recruitment_stage_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Campos por Etapa">
                    <field name="x_is_carta_oferta"/>
                    <field name="x_is_contrato_firmado"/>
                    <field name="x_is_medical_exam_stage"/>
                    <field name="x_is_third_interview_stage"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
