<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_inherit_compensation" model="ir.ui.view">
        <field name="name">account.move.form.inherit.compensation</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Botón "Aplicar Compensación" en el header -->
            <xpath expr="//header/button[@name='action_post']" position="after">
                <button name="action_open_compensation_wizard"
                        string="Aplicar Compensación"
                        type="object"
                        class="btn-primary"
                        groups="l10n_pe_account_compensation.group_compensation_user"
                        invisible="state != 'posted' or payment_state not in ('not_paid', 'partial') or move_type not in ('out_invoice', 'in_invoice') or is_compensation_move"/>
            </xpath>

            <!-- Botón "Revertir Compensación" para asientos de compensación -->
            <xpath expr="//header/button[@name='action_post']" position="after">
                <button name="action_reverse_compensation"
                        string="Revertir Compensación"
                        type="object"
                        class="btn-warning"
                        groups="l10n_pe_account_compensation.group_compensation_user"
                        confirm="¿Está seguro? Se romperá la conciliación y se creará un asiento de reverso."
                        invisible="not is_compensation_move or state != 'posted'"/>
            </xpath>

            <!-- Campos ocultos necesarios para los invisible= -->
            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="is_compensation_move" invisible="1"/>
                <field name="compensation_count" invisible="1"/>
            </xpath>

            <!-- Sección "Compensaciones aplicadas" al final del sheet -->
            <xpath expr="//notebook" position="inside">
                <page string="Compensaciones" name="compensation_page">
                    <field name="compensation_move_ids" nolabel="1" readonly="1">
                        <list create="false" delete="false">
                            <field name="name"/>
                            <field name="date"/>
                            <field name="ref"/>
                            <field name="amount_total_signed" string="Monto"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'posted'"
                                   decoration-info="state == 'draft'"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
