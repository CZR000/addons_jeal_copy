<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_inherit_create_employee" model="ir.ui.view">
        <field name="name">res.users.form.inherit.can.create.employee</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <!--
                Agrega el campo "Puede Crear Empleado" en la pestaña de
                Permisos de acceso, dentro de una sección de Reclutamiento.
                Solo visible para usuarios internos (no portal/público).
            -->
            <xpath expr="//page[@name='access_rights']" position="inside">
                <group string="Reclutamiento" invisible="share">
                    <field name="can_create_employee" widget="boolean_toggle"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
