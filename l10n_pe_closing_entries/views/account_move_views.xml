<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_account_move_filter_closing" model="ir.ui.view">
        <field name="name">account.move.select.closing</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_move_filter"/>
        <field name="arch" type="xml">
            <!-- Se ancla en //search (siempre presente) en lugar de en un filtro
                 concreto, para no romperse si Odoo reorganiza la vista base. -->
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="closing_entries"
                        string="Asientos de Cierre"
                        domain="[('is_closing_entry', '=', True)]"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_move_form_closing" model="ir.ui.view">
        <field name="name">account.move.form.closing</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Se añade una página propia al notebook en lugar de anclar en
                 //field[@name='ref'], que aparece varias veces en la vista base
                 (referencia de factura de proveedor, referencia del asiento...). -->
            <xpath expr="//sheet/notebook" position="before">
                <field name="is_closing_entry" invisible="1"/>
            </xpath>
            <xpath expr="//sheet/notebook" position="inside">
                <page name="closing_info"
                      string="Cierre Contable"
                      invisible="not is_closing_entry">
                    <group>
                        <group>
                            <field name="closing_level" readonly="1"/>
                        </group>
                        <group>
                            <field name="closing_date_from" readonly="1"/>
                            <field name="closing_date_to" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_closing_entry_moves" model="ir.actions.act_window">
        <field name="name">Asientos de Cierre Generados</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_closing_entry', '=', True)]</field>
        <field name="context">{'create': False}</field>
        <!-- Sin esto, account.move resuelve por defecto la vista de FACTURAS
             (account.view_account_invoice_filter) y el filtro «Asientos de
             Cierre» —que se hereda de la vista de asientos— no aparecería. -->
        <field name="search_view_id" ref="account.view_account_move_filter"/>
        <field name="view_id" ref="account.view_move_tree"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aún no se ha generado ningún asiento de cierre
            </p>
            <p>
                Use «Generar Asientos de Cierre» para crearlos a partir de la
                configuración del plan contable.
            </p>
        </field>
    </record>
</odoo>
