<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!--
        Odoo 18: el atributo `attrs="{...}"` fue eliminado en v17. Los
        modificadores invisible/readonly/required se declaran como
        atributos directos con expresiones Python.
    -->
    <record id="mrp_production_form_view_inherit_mrp_cost_liquidation" model="ir.ui.view">
        <field name="name">mrp.production.view.form.inherit.mrp_cost_liquidation</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field
                    name="partner_id"
                    options="{'no_create': True, 'no_open': True}"
                    readonly="state in ['done', 'cancel']"/>
            </xpath>

            <xpath expr="//field[@name='company_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="mrp_production_tree_view_inherit_mrp_cost_liquidation" model="ir.ui.view">
        <field name="name">mrp.production.list.view.inherit.mrp_cost_liquidation</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="partner_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
