<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 18: `attrs` eliminado → atributo `invisible` directo. -->
    <record id="account_move_form_inherit_mrp_production" model="ir.ui.view">
        <field name="name">account.move.form.inherit.mrp.production</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="manufacturing" string="Producción"
                      invisible="move_type not in ('in_invoice', 'in_refund', 'out_invoice', 'out_refund')">
                    <group>
                        <field name="mrp_production_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
