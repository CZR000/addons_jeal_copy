<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ================================================================
         Vista Lista
         ================================================================ -->
    <record id="ple_report_cash_book_view_list" model="ir.ui.view">
        <field name="name">ple.report.cash.book.list</field>
        <field name="model">ple.report.cash.book</field>
        <field name="arch" type="xml">
            <list string="Libro Caja 1.1">
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="company_id"/>
                <field name="date_generated"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'confirmed'"/>
            </list>
        </field>
    </record>

    <!-- ================================================================
         Vista Formulario
         ================================================================ -->
    <record id="ple_report_cash_book_view_form" model="ir.ui.view">
        <field name="name">ple.report.cash.book.form</field>
        <field name="model">ple.report.cash.book</field>
        <field name="arch" type="xml">
            <form string="Libro Caja 1.1">
                <header>
                    <button name="action_generate_xlsx"
                            string="Generar Excel"
                            type="object"
                            class="oe_highlight"/>
                    <button name="action_generate_pdf"
                            string="Generar PDF"
                            type="object"/>
                    <button name="action_reset_to_draft"
                            string="Regresar a Borrador"
                            type="object"
                            invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <group string="Reporte PLE - Libro Caja y Bancos 1.1"
                           name="ple_cash_book_header">
                        <group>
                            <field name="company_id"
                                   readonly="state != 'draft'"/>
                            <field name="date_start"
                                   readonly="state != 'draft'"/>
                            <field name="date_end"
                                   readonly="state != 'draft'"/>
                            <field name="date_generated"/>
                        </group>
                    </group>
                    <group string="Archivo Generado"
                           name="ple_cash_book_file"
                           invisible="state != 'confirmed'">
                        <field name="xls_filename" invisible="1"/>
                        <field name="xls_binary"
                               filename="xls_filename"
                               readonly="1"
                               string="Reporte Excel"/>
                        <field name="pdf_filename" invisible="1"/>
                        <field name="pdf_binary"
                               filename="pdf_filename"
                               readonly="1"
                               string="Reporte PDF"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ================================================================
         Accion + Menu
         ================================================================ -->
    <record id="ple_report_cash_book_action" model="ir.actions.act_window">
        <field name="name">Libro Caja 1.1</field>
        <field name="res_model">ple.report.cash.book</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Genere un nuevo Reporte PLE - Libro de Caja y Bancos
                Formato 1.1
            </p>
            <p>
                Seleccione la compañia y el rango de fechas del periodo, y
                pulse "Generar Reporte" para obtener el archivo Excel.
            </p>
        </field>
    </record>

    <menuitem id="menu_ple_cash_book_11"
              name="Libro Caja 1.1"
              parent="ple_sale_book.menu_ple_physical_books"
              action="ple_report_cash_book_action"
              sequence="13"/>

</odoo>
