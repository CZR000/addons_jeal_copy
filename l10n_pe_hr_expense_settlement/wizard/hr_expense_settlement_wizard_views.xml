<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_expense_settlement_wizard_view_form" model="ir.ui.view">
        <field name="name">hr.expense.settlement.wizard.form</field>
        <field name="model">hr.expense.settlement.wizard</field>
        <field name="arch" type="xml">
            <form string="Conciliar con Anticipo">
                <field name="company_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <field name="employee_partner_id" invisible="1"/>
                <div class="alert alert-info" role="alert" invisible="line_ids">
                    <field name="employee_id" readonly="1" class="fw-bold"/> no tiene anticipos abiertos en las cuentas
                    de entregas a rendir: el saldo de la factura quedará a favor del empleado, para reembolsárselo.
                </div>
                <group>
                    <group>
                        <field name="move_id"/>
                        <field name="employee_id" readonly="1"/>
                        <field name="invoice_residual"/>
                    </group>
                    <group>
                        <field name="journal_id" options="{'no_create': True}"/>
                        <field name="date"/>
                    </group>
                </group>
                <field name="line_ids" nolabel="1" invisible="not line_ids">
                    <list editable="bottom" create="0" delete="0">
                        <field name="currency_id" column_invisible="1"/>
                        <field name="advance_currency_id" column_invisible="1"/>
                        <field name="advance_line_id" column_invisible="1" force_save="1"/>
                        <field name="selected" widget="boolean_toggle"/>
                        <field name="date" readonly="1"/>
                        <field name="advance_move_id" readonly="1"/>
                        <field name="name" readonly="1" optional="show"/>
                        <field name="account_id" readonly="1" optional="show"/>
                        <field name="amount_residual_currency" readonly="1"/>
                        <field name="available_amount" readonly="1"/>
                        <field name="applied_amount" readonly="1" decoration-bf="1"/>
                    </list>
                </field>
                <group>
                    <group>
                        <field name="selected_advance_amount" invisible="not line_ids"/>
                        <field name="amount" readonly="1"/>
                        <field name="excess_amount" invisible="not excess_amount"/>
                        <field name="excess_account_id"
                               invisible="not excess_amount"
                               required="excess_amount"
                               options="{'no_create': True}"/>
                    </group>
                </group>
                <div class="alert alert-warning" role="alert" invisible="not excess_amount or not line_ids">
                    Los anticipos marcados no cubren toda la factura: la diferencia quedará como saldo a favor
                    del empleado en la cuenta indicada, para reembolsárselo con un pago.
                </div>
                <footer>
                    <button name="action_confirm" type="object" string="Conciliar" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
