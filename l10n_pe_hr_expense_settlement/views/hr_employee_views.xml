<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_form" model="ir.ui.view">
        <field name="name">hr.employee.form.l10n_pe_settlement</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='hr_settings']/group" position="inside">
                <group string="Contabilidad" name="expense_accounting_group"
                       groups="analytic.group_analytic_accounting">
                    <field name="analytic_precision" invisible="1"/>
                    <field name="expense_analytic_distribution"
                           widget="analytic_distribution"
                           options="{'business_domain': 'expense'}"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
