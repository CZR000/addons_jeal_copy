<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.l10n_pe_settlement</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@id='account_invoice_payment_btn']" position="before">
                <field name="hr_expense_can_settle" invisible="1"/>
                <button name="action_open_hr_expense_settlement_wizard" type="object"
                        string="Conciliar con Anticipo" class="oe_highlight"
                        invisible="not hr_expense_can_settle"
                        groups="account.group_account_invoice"/>
            </xpath>
            <div name="button_box" position="inside">
                <button name="action_view_hr_expense_settlements" type="object"
                        class="oe_stat_button" icon="fa-exchange"
                        invisible="not hr_expense_settlement_count">
                    <field name="hr_expense_settlement_count" string="Liquidaciones" widget="statinfo"/>
                </button>
            </div>
            <xpath expr="//field[@name='ref'][not(@nolabel)]" position="after">
                <field name="hr_expense_settlement_bill_id" invisible="not hr_expense_settlement_bill_id"/>
            </xpath>
        </field>
    </record>

</odoo>
