<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_line_tree_inherit_default_code" model="ir.ui.view">
        <field name="name">stock.move.line.tree.inherit.default.code</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="product_default_code" string="Referencia Interna" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
