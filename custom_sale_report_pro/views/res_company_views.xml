<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_product_view_form_variant_custom_desc" model="ir.ui.view">
        <field name="name">product.product.view.form.variant.custom.desc</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">                
            
            <!-- 1. Ocultar la descripción base estándar (Sintaxis V18) -->
            <xpath expr="//group[@name='description']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>

            <!-- 2. Reemplazo UI para la Gestión de Contenido de Ventas -->
            <xpath expr="//group[@name='sale']" position="after">
                
                <!-- Alerta informativa UI -->
                <div class="alert alert-info d-flex align-items-center mt-4 mb-4" role="alert">
                    <i class="fa fa-info-circle fa-2x me-3" title="Información"/>
                    <div class="flex-grow-1">
                        <b class="d-block mb-1">Configure los textos técnicos y comerciales</b>
                        <span class="small">
                            Si habilita la siguiente opción, la <b>Descripción Final</b> en el PDF será la combinación del Nivel Plantilla + Nivel Variante.
                        </span>
                    </div>
                    <div class="ms-3">
                        <field name="include_template_description" widget="boolean_toggle" nolabel="1"/>
                    </div>
                </div>

                <!-- Layout nativo de 2 columnas usando <group> -->
                <group string="Gestión de Contenido de Ventas">
                    <group>
                        <!-- Columna Izquierda: Nivel Plantilla -->
                        <div colspan="2" class="mb-2">
                            <div class="text-primary d-flex align-items-center mb-1">
                                <i class="fa fa-globe me-2"/> <b class="fs-5">Nivel Plantilla (General)</b>
                            </div>
                            <div class="text-muted small">
                                Texto base compartido por todas las variantes de este producto.
                            </div>
                        </div>
                        <field name="description_sale" 
                               nolabel="1" 
                               colspan="2"
                               placeholder="Ej: Especificaciones generales, marca, modelo base..."/>
                    </group>
                    
                    <group>
                        <!-- Columna Derecha: Nivel Variante -->
                        <div colspan="2" class="mb-2">
                            <div class="text-success d-flex align-items-center mb-1">
                                <i class="fa fa-tag me-2"/> <b class="fs-5">Nivel Variante (Específico)</b>
                            </div>
                            <div class="text-muted small">
                                Detalles únicos para esta variante específica.
                            </div>
                        </div>
                        <field name="variant_description_sale" 
                               widget="html" 
                               nolabel="1"
                               colspan="2"
                               options="{'collaborative': true}"
                               placeholder="Ej: Color Rojo, Voltaje 220V, Talla XL..."/>
                    </group>
                </group>
            </xpath>

            <!-- 3. Inyección del Notebook Page para la Garantía -->
            <xpath expr="//notebook" position="inside">
                <page string="Términos y Garantía" name="warranty_terms">
                    
                    <!-- Cabecera de la pestaña -->
                    <div class="d-flex justify-content-between align-items-start mt-2 mb-3">
                        <div class="text-muted small w-75">
                            Modifique los términos y condiciones de garantía específicos para este producto. 
                            Por defecto, se heredan de la configuración general de la compañía.
                        </div>
                        <button name="action_reset_warranty_terms" 
                                type="object" 
                                class="btn btn-secondary btn-sm" 
                                string="Restaurar Plantilla" 
                                icon="fa-refresh"
                                help="Sobrescribe el contenido actual con el estándar de la compañía."/>
                    </div>
                    
                    <!-- Campo HTML a pantalla completa -->
                    <field name="custom_warranty_terms" 
                           widget="html" 
                           nolabel="1"
                           options="{'collaborative': true}"
                           placeholder="Escriba aquí las condiciones de garantía específicas para este producto..."/>
                </page>
            </xpath>
            
        </field>
    </record>
</odoo>