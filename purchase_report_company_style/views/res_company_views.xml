<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <record id="view_company_form_inherit_po_report_style" model="ir.ui.view">
            <field name="name">res.company.form.inherit.po.report.style</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='general_info']/group" position="inside">
                    <group string="Purchase Report">
                        <field name="custom_po_report_style"/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
