<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Medio de pago (tabla 1) del Libro Bancos: editable también publicado. -->
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.ple_cash_book_jeal</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@id='other_tab_entry']//group[@name='misc_group']" position="inside">
                <field name="payment_method_id" string="Medio de pago (Libro Bancos)"
                       options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <record id="view_bank_statement_line_tree" model="ir.ui.view">
        <field name="name">account.bank.statement.line.list.ple_cash_book_jeal</field>
        <field name="model">account.bank.statement.line</field>
        <field name="inherit_id" ref="account_accountant.view_bank_statement_line_tree_bank_rec_widget"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="payment_method_id" string="Medio de pago" optional="show"
                       options="{'no_create': True}"/>
            </field>
        </field>
    </record>

    <record id="view_bank_statement_line_form" model="ir.ui.view">
        <field name="name">account.bank.statement.line.form.ple_cash_book_jeal</field>
        <field name="model">account.bank.statement.line</field>
        <field name="inherit_id" ref="account_accountant.view_bank_statement_line_form_bank_rec_widget"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="payment_method_id" string="Medio de pago" options="{'no_create': True}"/>
            </field>
        </field>
    </record>

</odoo>
