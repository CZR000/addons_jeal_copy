<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_picking_form_inherit_stock_picking_weighing" model="ir.ui.view">
        <field name="name">stock.picking.view.form.inherit.stock_picking_weighing</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='operations']//list//field[@name='product_id']" position="after">
                <field name="initial_weight" optional="show"/>                
                <field name="final_weight" optional="show"/>
                <field name="weight_diff" optional="hide"/>
            </xpath>

            <xpath expr="//page[@name='extra']" position="before">
                <page name="weighing" string="Pesaje">
                    <group>
                        <group>
                            <field name="initial_weight_at"/>
                            <field name="final_weight_at"/>
                        </group>
                        <group>
                            <field name="initial_weight"/>
                            <field name="final_weight"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
