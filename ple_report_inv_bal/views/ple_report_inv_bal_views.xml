<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ================================================================
         Vista Lista
         ================================================================ -->
    <record id="ple_report_inv_bal_view_list" model="ir.ui.view">
        <field name="name">ple.report.inv.bal.book.list</field>
        <field name="model">ple.report.inv.bal.book</field>
        <field name="arch" type="xml">
            <list string="Libro Inventarios y Balances">
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="company_id"/>
                <field name="date_generated"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'confirmed'"/>
            </list>
        </field>
    </record>

    <!-- ================================================================
         Vista Formulario
         ================================================================ -->
    <record id="ple_report_inv_bal_view_form" model="ir.ui.view">
        <field name="name">ple.report.inv.bal.book.form</field>
        <field name="model">ple.report.inv.bal.book</field>
        <field name="arch" type="xml">
            <form string="Libro Inventarios y Balances">
                <header>
                    <button name="action_generate_all_xls"
                            string="Generar Excel"
                            type="object" class="btn-primary"/>
                    <button name="action_generate_all_pdf"
                            string="Generar PDF"
                            type="object" class="btn-primary"/>
                    <button name="action_reset_to_draft"
                            string="Regresar a Borrador"
                            type="object"
                            invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <group string="Libro de Inventarios y Balances (Formatos 3.1 a 3.20)"
                           name="inv_bal_header">
                        <group>
                            <field name="company_id" readonly="state != 'draft'"/>
                            <field name="date_start" readonly="state != 'draft'"/>
                            <field name="date_end" readonly="state != 'draft'"/>
                            <!-- Se detectan solos; visibles solo en modo desarrollador -->
                            <field name="closing_journal_ids" widget="many2many_tags"
                                   readonly="state != 'draft'" groups="base.group_no_one"/>
                            <field name="opening_journal_ids" widget="many2many_tags"
                                   readonly="state != 'draft'" groups="base.group_no_one"/>
                            <field name="date_generated"/>
                            <field name="show_by_format"/>
                        </group>
                        <group string="Libro Completo (3.1 a 3.20)" name="inv_bal_all"
                               invisible="not xls_binary_all and not pdf_binary_all">
                            <field name="xls_filename_all" invisible="1"/>
                            <field name="xls_binary_all" filename="xls_filename_all"
                                   string="Libro Excel" readonly="1"
                                   invisible="not xls_binary_all"/>
                            <field name="pdf_filename_all" invisible="1"/>
                            <field name="pdf_binary_all" filename="pdf_filename_all"
                                   string="Libro PDF" readonly="1"
                                   invisible="not pdf_binary_all"/>
                        </group>
                    </group>
                    <group name="inv_bal_sections" invisible="not show_by_format">
                        <group string="Reporte 3.1 - Balance General" name="sec_01">
                            <button name="action_generate_01" string="Generar Reporte 3.1"
                                    type="object" class="btn-primary oe_highlight"
                                    colspan="2"/>
                            <field name="xls_filename_01" invisible="1"/>
                            <label string="Reporte Excel" for="xls_binary_01"/>
                            <field name="xls_binary_01" filename="xls_filename_01" readonly="1" nolabel="1"/>
                            <field name="pdf_filename_01" invisible="1"/>
                            <label string="Reporte PDF" for="pdf_binary_01"/>
                            <field name="pdf_binary_01" filename="pdf_filename_01" readonly="1" nolabel="1"/>
                        </group>
                        <group string="Reporte 3.2 - Efectivo y Equivalente al Efectivo (Cuenta 10)" name="sec_02">
                            <button name="action_generate_02" string="Generar Reporte 3.2"
