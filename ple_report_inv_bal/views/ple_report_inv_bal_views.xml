    <!-- ================================================================
         Accion + Menu
         ================================================================ -->
    <record id="ple_report_inv_bal_action" model="ir.actions.act_window">
        <field name="name">Libro Inventarios y Balances</field>
        <field name="res_model">ple.report.inv.bal.book</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Genere un nuevo Libro de Inventarios y Balances (Formatos 3.1 a 3.20)
            </p>
            <p>
                Seleccione la compania y el rango de fechas (inicio y fin), y use los botones
                "Generar Excel" o "Generar PDF" para obtener el libro completo. Marque
                "Generar por formato" para generar cada formato 3.X por separado.
            </p>
        </field>
    </record>

    <menuitem id="menu_ple_inv_bal_3x"
