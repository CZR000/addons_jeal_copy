<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_pdiff" model="ir.ui.view">
        <field name="name">res.config.settings.form.pdiff</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='account_vendor_bills']" position="inside">
                <setting id="pdiff_block_reset_to_draft_setting"
                         string="Bloquear reinicio a borrador de facturas valorizadas"
                         help="Impide pasar a borrador facturas de proveedor que ya generaron capas de valorización de inventario.">
                    <field name="pdiff_block_reset_to_draft"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
