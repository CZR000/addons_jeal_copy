<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <record id="view_picking_inh_form" model="ir.ui.view">
            <field name="name">stock.picking.inh.form</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form" />
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button name="add_operation_type" type="object" string="Agregar Tipo Operación" class="btn-secondary"/>
                </xpath>

                <xpath expr="//field[@name='move_ids_without_package']/list/field[@name='description_picking']" position="after">
                    <field name="sunat_operation_type" string="Tipo Operación SUNAT" optional="show"/>
                </xpath>

                <xpath expr="//page[@name='operations']" position="after">
                    <page string="Tipos de Operación SUNAT" name="operation_type">
                        <field name="operation_type_ids">
                            <list create="false" delete="false" editable="bottom">
                                <field name="move_id" readonly="1" force_save="1"/>
                                <field name="product_id" readonly="1" force_save="1"/>
                                <field name="sunat_operation_type"/>
                            </list>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>

        <record id="view_stock_move_operations_inh" model="ir.ui.view">
            <field name="name">stock.move.operations.inh</field>
            <field name="model">stock.move</field>
            <field name="inherit_id" ref="stock.view_stock_move_operations" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='product_id']" position="after">
                    <field name="sunat_operation_type" string="Tipo Operación SUNAT"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
