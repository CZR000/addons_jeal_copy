<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_analytic_account_form_restriction" model="ir.ui.view">
        <field name="name">account.analytic.account.form.restriction</field>
        <field name="model">account.analytic.account</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_account_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='main']/group[2]/field[@name='currency_id']" position="after">
                <field name="allowed_account_ids"
                       string="Cuentas de gastos permitidas"
                       widget="many2many_tags"
                       options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
