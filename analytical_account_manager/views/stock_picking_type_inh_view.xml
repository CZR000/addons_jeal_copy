        <!-- 
        <record id="stock_picking_type_form_inh_analytic" model="ir.ui.view">
        <field name="name">stock.picking.type.form.inh.analytic</field> 
         -->
        <record id="stock_picking_type_form_inh" model="ir.ui.view">
            <field name="name">stock.picking.type.form.inh</field>
            <field name="model">stock.picking.type</field>
            <field name="inherit_id" ref="stock.view_picking_type_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page name="account_config" string="Contabilidad">
                        <group name="analytic_account" string="Cuentas analíticas">
                            <field name="is_analytic_account" widget="boolean_toggle"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
