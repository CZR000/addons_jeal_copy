<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <record id="stock_picking_form_inh_analytic" model="ir.ui.view">
            <field name="name">stock.picking.form.inh.analytic</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button name="button_add_analytic_account" 
                        type        = "object" 
                        string      = "Sincronizar Analítica a Contabilidad" 
                        class       = "btn-secondary" 
                        confirm     = "Esto forzará la actualización de la cuenta analítica en los asientos contables (incluso si están validados). ¿Desea continuar?" 
                        invisible   = "not show_analytic_section"/>
                </xpath>

                <xpath expr="//field[@name='origin']" position="after">
                    <field name="is_analytic_account" invisible="1" />
                    <field name="show_analytic_section" invisible="1" />

                    <field name="analytic_plan_id" invisible="not show_analytic_section"/>

                    <label for="analytic_account_id" invisible="not show_analytic_section"/>
                    <div class="o_row" invisible="not show_analytic_section">
                        <field name="analytic_account_id"/>
                        <button name="button_add" type="object" string="Asignar a líneas" class="btn-link" icon="fa-arrow-down"/>
                    </div>
                </xpath>

                <xpath expr="//page[@name='operations']" position="after">
                    <page string="Cuentas Analíticas" name="analytic_account_page" invisible="not show_analytic_section">
                        <field name="move_line_ids" readonly="state == 'done'">
                            <list editable="bottom" create="0" delete="0">
                                <field name="product_id" readonly="1" force_save="1"/>
                                <field name="qty_done" readonly="1" string="Hecho"/>
                                <field name="analytic_plan_id"/>
                                <field name="analytic_id" domain="[('plan_id', '=', analytic_plan_id)]"/>
                            </list>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
