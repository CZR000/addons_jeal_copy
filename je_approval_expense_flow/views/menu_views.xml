<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="approval_category_action_expense_new_request" model="ir.actions.act_window">
        <field name="name">Solicitudes</field>
        <field name="res_model">approval.category</field>
        <field name="view_mode">kanban</field>
        <field name="views" eval="[(ref('approvals.approval_category_view_kanban'), 'kanban')]"/>
        <field name="domain">[('is_expense_category', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay categorías de solicitud marcadas para Gastos.
            </p>
            <p>
                Marque "Aplica a Informe de Gastos" en Aprobaciones &gt; Configuración &gt;
                Tipos de aprobación para que aparezcan aquí.
            </p>
        </field>
    </record>

    <menuitem id="menu_hr_expense_approvals"
              name="Solicitudes de Aprobacion"
              parent="hr_expense.menu_hr_expense_root"
              action="approval_category_action_expense_new_request"
              sequence="3"/>
</odoo>
