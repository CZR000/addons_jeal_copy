<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_je" model="ir.ui.view">
        <field name="name">account.move.form.je</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Empleado - Cuenta 14 y pagos pendientes"
                      name="expense_employee_detail"
                      invisible="not expense_employee_partner_id">
                    <field name="expense_employee_partner_id" invisible="1"/>
                    <group>
                        <field name="expense_employee_account14_line_ids" nolabel="1">
                            <list string="Cuenta 14 pendiente del empleado" create="0" edit="0" delete="0">
                                <field name="move_id"/>
                                <field name="date"/>
                                <field name="account_id"/>
                                <field name="name"/>
                                <field name="debit"/>
                                <field name="credit"/>
                            </list>
                        </field>
                    </group>
                    <group>
                        <field name="expense_employee_pending_payment_ids" nolabel="1">
                            <list string="Pagos pendientes de conciliar del empleado" create="0" edit="0" delete="0">
                                <field name="name"/>
                                <field name="date"/>
                                <field name="journal_id"/>
                                <field name="amount"/>
                                <field name="state"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
