<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_discount_reject_wizard_form" model="ir.ui.view">
        <field name="name">sale.discount.reject.wizard.form</field>
        <field name="model">sale.discount.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Rechazar Descuento">
                <sheet>
                    <field name="order_id" invisible="1"/>
                    <div class="alert alert-warning mb16" role="alert">
                        <strong>Rechazo de descuento</strong><br/>
                        Al rechazar, el usuario solicitante será notificado para que
                        ajuste los descuentos y solicite una nueva autorización.
                    </div>
                    <field name="rejection_reason"
                           placeholder="Ingrese el motivo del rechazo..."
                           nolabel="1"
                           style="min-height: 100px; width: 100%;"/>
                </sheet>
                <footer>
                    <button string="Rechazar Descuento"
                            name="action_reject"
                            type="object"
                            class="btn-danger"/>
                    <button string="Cancelar"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
