<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <record id="view_stock_request_order_product_ids_search" model="ir.ui.view">
            <field name="name">view.stock.request.order.product.ids.search</field>
            <field name="model">stock.request.order</field>
            <field name="inherit_id" ref="stock_request.stock_request_order_search"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="stock_request_ids" string="Producto" filter_domain="['|', ('stock_request_ids.product_id.name', 'ilike', self), ('stock_request_ids.product_id.default_code', 'ilike', self)]"/>

                    <field name="product_ids" string="Variante" />
                </xpath>
            </field>
        </record>
    </data>
</odoo>
