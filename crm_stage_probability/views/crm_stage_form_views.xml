<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <record id="crm_stage_form_inherit_probability" model="ir.ui.view">
            <field name="name">crm.stage.form.inherit.probability</field>
            <field name="model">crm.stage</field>
            <field name="inherit_id" ref="crm.crm_stage_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='is_won']" position="after">
                    <field name="stage_probability"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
