<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_advance_role" model="ir.ui.view">
        <field name="name">product.template.form.advance.role</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='property_account_income_id']" position="after">
                <field name="advance_role"/>
            </xpath>
        </field>
    </record>
</odoo>
