<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_advance_config_list" model="ir.ui.view">
        <field name="name">l10n_pe.advance.config.list</field>
        <field name="model">l10n_pe.advance.config</field>
        <field name="arch" type="xml">
            <list string="Configuracion de anticipos y revolventes">
                <field name="advance_type"/>
                <field name="currency_id"/>
                <field name="control_account_id"/>
                <field name="origin_product_id"/>
                <field name="application_product_id"/>
                <field name="compensation_journal_id"/>
                <field name="closing_tolerance"/>
            </list>
        </field>
    </record>

    <record id="view_advance_config_form" model="ir.ui.view">
        <field name="name">l10n_pe.advance.config.form</field>
        <field name="model">l10n_pe.advance.config</field>
        <field name="arch" type="xml">
            <form string="Configuracion">
                <sheet>
                    <group>
                        <group string="Identificacion">
                            <field name="advance_type"/>
                            <field name="currency_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="control_account_id"/>
                        </group>
                        <group string="Productos y diario">
                            <field name="origin_product_id"
                                   invisible="advance_type == 'revolving'"/>
                            <field name="application_product_id"
                                   invisible="advance_type == 'revolving'"/>
                            <field name="compensation_journal_id"/>
                            <field name="revolving_journal_ids"
                                   widget="many2many_tags"
                                   invisible="advance_type != 'revolving'"/>
                        </group>
                    </group>
                    <group string="Cierre por redondeo">
                        <field name="closing_tolerance"/>
                        <field name="rounding_expense_account_id"/>
                        <field name="rounding_income_account_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_advance_config" model="ir.actions.act_window">
        <field name="name">Configuracion de anticipos y revolventes</field>
        <field name="res_model">l10n_pe.advance.config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
