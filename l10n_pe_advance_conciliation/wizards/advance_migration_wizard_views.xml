<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_advance_migration_wizard_form" model="ir.ui.view">
        <field name="name">l10n_pe.advance.migration.wizard.form</field>
        <field name="model">l10n_pe.advance.migration.wizard</field>
        <field name="arch" type="xml">
            <form string="Migracion de saldos iniciales">
                <group>
                    <group>
                        <field name="config_id"/>
                        <field name="advance_type" readonly="1"/>
                    </group>
                    <group>
                        <field name="control_account_id" readonly="1"/>
                        <field name="currency_id" readonly="1"/>
                    </group>
                </group>
                <button name="action_load_open_items" type="object"
                        string="Cargar saldos por conciliar" class="btn-secondary"/>
                <field name="line_ids">
                    <list editable="bottom" create="false">
                        <field name="to_migrate"/>
                        <field name="partner_id" readonly="1"/>
                        <field name="origin_move_id" readonly="1"/>
                        <field name="amount_base"/>
                        <field name="currency_id" column_invisible="1"/>
                    </list>
                </field>
                <footer>
                    <button name="action_migrate" type="object"
                            string="Migrar" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_advance_migration" model="ir.actions.act_window">
        <field name="name">Migracion de saldos iniciales</field>
        <field name="res_model">l10n_pe.advance.migration.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
