<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_commission_plan_view_form" model="ir.ui.view">
        <field name="name">sale.commission.plan.form.currency</field>
        <field name="model">sale.commission.plan</field>
        <field name="inherit_id" ref="sale_commission.sale_commission_plan_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet//group/field[@name='currency_id']" position="attributes">
                <attribute name="invisible"/>
                <attribute name="readonly">state != 'draft'</attribute>
                <attribute name="options">{'no_create': True}</attribute>
                <attribute name="groups">base.group_multi_currency</attribute>
            </xpath>
        </field>
    </record>

    <record id="sale_commission_plan_view_list" model="ir.ui.view">
        <field name="name">sale.commission.plan.list.currency</field>
        <field name="model">sale.commission.plan</field>
        <field name="inherit_id" ref="sale_commission.sale_commission_plan_view_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="currency_id" optional="show" groups="base.group_multi_currency"/>
            </xpath>
        </field>
    </record>

</odoo>
