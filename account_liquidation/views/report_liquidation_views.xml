<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="account_liquidation_action" model="ir.actions.act_window">
        <field name="name">Liquidaciones</field>
        <field name="res_model">report.liquidation</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="account_liquidation_view_form" model="ir.ui.view">
        <field name="name">account.liquidation.view.form</field>
        <field name="model">report.liquidation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_done" string="Terminado" invisible="state != 'in_progress'" class="oe_highlight" type="object"/>
                    <button name="action_to_draft" string="Regresar a borrador" invisible="state != 'in_progress'" type="object"/>
                    <button name="action_to_progress" string="En progreso" invisible="state != 'draft'" type="object" class="oe_highlight"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet readonly="state in ['done', 'in_progress']">

                    <field name="is_readonly" invisible="1"/>

                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_report_liquidation)d" type="action" class="oe_stat_button" icon="fa-money">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Resumen</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name" string="Liquidación"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="date" readonly="state in ['done', 'in_progress']"/>
                            <field name="partner_id" readonly="state in ['done', 'in_progress']"/>
                            <field name="picking_ids" widget="many2many_tags" readonly="state in ['done', 'in_progress']" domain="[
                                    ('company_id', '=', company_id),
                                    ('state', '=', 'done')
                                ]"/>
                        </group>
                        <group>
                            <field name="company_id"/>
                        </group>
                    </group>

                    <notebook>
                        <page name="operations" string="Operaciones">
                            <field name="operation_ids" readonly="state in ['done', 'in_progress']">
                                <list create="0" edit="0" delete="0">
                                    <field name="liquidation_id" column_invisible="True"/>
                                    <field name="product_id" widget="many2one"/>
                                    <field name="initial_weight"/>
                                    <field name="final_weight"/>
                                    <field name="qty_done"/>
                                    <field name="picking_id" widget="many2one"/>
                                    <field name="delivery_note"/>
                                </list>
                            </field>
                        </page>

                        <page name="transport" string="Transporte">
                            <field name="transport_ids" domain="[('type','=','transport')]" context="{'default_type':'transport', 'default_liquidation_id': id}" readonly="state in ['done', 'in_progress']">
                                <list editable="bottom">
                                    <field name="type" optional="hide"/>
                                    <field name="liquidation_id" column_invisible="True"/>
                                    <field name="company_currency_id" column_invisible="True"/>
                                    <field name="move_currency_id" column_invisible="True"/>
                                    <field name="move_id" widget="many2one" domain="[
                                            ('state', '=', 'posted'),
                                            ('move_type', '=', 'in_invoice')
                                        ]"/>
                                    <field name="partner_id" widget="many2one" optional="show"/>
                                    <field name="ref" optional="show"/>
                                    <field name="invoice_date"/>
                                    <field name="subtotal" options="{'currency_field': 'move_currency_id'}" optional="show"/>
                                    <field name="exchange_rate"/>
                                    <field name="subtotal_company" options="{'currency_field': 'company_currency_id'}"/>
                                    <field name="tax_company" options="{'currency_field': 'company_currency_id'}"/>
                                    <field name="total_company" options="{'currency_field': 'company_currency_id'}" sum="Total"/>
                                </list>
                            </field>
                        </page>

                        <page name="process_cost" string="Costos de proceso">
                            <field name="process_ids" domain="[('type','=','process')]" context="{'default_type':'process', 'default_liquidation_id': id}" readonly="state in ['done', 'in_progress']">
                                <list editable="bottom">
                                    <field name="type" optional="hide"/>
                                    <field name="liquidation_id" column_invisible="True"/>
                                    <field name="company_currency_id" column_invisible="True"/>
                                    <field name="move_currency_id" column_invisible="True"/>
                                    <field name="move_id" widget="many2one" domain="[
                                            ('state', '=', 'posted'),
                                            ('move_type', '=', 'in_invoice')
                                        ]"/>
                                    <field name="partner_id" widget="many2one" optional="show"/>
                                    <field name="ref" optional="show"/>
                                    <field name="invoice_date"/>
                                    <field name="subtotal" options="{'currency_field': 'move_currency_id'}" optional="show"/>
                                    <field name="exchange_rate"/>
                                    <field name="subtotal_company" options="{'currency_field': 'company_currency_id'}"/>
                                    <field name="tax_company" options="{'currency_field': 'company_currency_id'}"/>
                                    <field name="total_company" options="{'currency_field': 'company_currency_id'}" sum="Total"/>
                                </list>
                            </field>
                        </page>

                        <page name="invoiced" string="Facturado">
                            <field name="invoiced_ids" domain="[('type','=','billed')]" context="{'default_type':'billed', 'default_liquidation_id': id}" readonly="state in ['done', 'in_progress']">
                                <list editable="bottom">
                                    <field name="type" optional="hide"/>
                                    <field name="liquidation_id" column_invisible="True"/>
                                    <field name="company_currency_id" column_invisible="True"/>
                                    <field name="move_currency_id" column_invisible="True"/>
                                    <field name="move_id" widget="many2one" domain="[
                                            ('state', '=', 'posted'), ('move_type','=','out_invoice'), ('partner_id','=',parent.partner_id)
                                        ]"/>
                                    <field name="partner_id" widget="many2one" optional="show"/>
                                    <field name="ref" optional="show"/>
                                    <field name="invoice_date"/>
                                    <field name="subtotal" options="{'currency_field': 'move_currency_id'}" optional="show"/>
                                    <field name="exchange_rate"/>
                                    <field name="subtotal_company" options="{'currency_field': 'company_currency_id'}"/>
                                    <field name="tax_company" options="{'currency_field': 'company_currency_id'}"/>
                                    <field name="total_company" options="{'currency_field': 'company_currency_id'}" sum="Total"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="report_liquidation_view_tree" model="ir.ui.view">
        <field name="name">report.liquidation.view.tree</field>
        <field name="model">report.liquidation</field>
        <field name="arch" type="xml">
            <list string="Liquidaciones" default_order="date desc, id desc">
                <field name="name" string="Liquidación"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state" widget="badge" decoration-muted="state == 'cancel'" decoration-success="state == 'done'" decoration-warning="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="report_liquidation_view_search" model="ir.ui.view">
        <field name="name">report.liquidation.view.search</field>
        <field name="model">report.liquidation</field>
        <field name="arch" type="xml">
            <search string="Buscar Liquidaciones">
                <field name="name" string="Liquidación"/>
                <field name="partner_id"/>
                <field name="date"/>
                <field name="company_id" groups="base.group_multi_company"/>

                <separator/>

                <filter string="Borrador" name="filter_draft" domain="[('state','=','draft')]"/>
                <filter string="Realizado" name="filter_done" domain="[('state','=','done')]"/>
                <filter string="Cancelado" name="filter_cancel" domain="[('state','=','cancel')]"/>

                <separator/>

                <group expand="0" string="Agrupar por">
                    <filter string="Cliente" name="group_partner" context="{'group_by':'partner_id'}"/>
                    <filter string="Fecha" name="group_date" context="{'group_by':'date'}"/>
                    <filter string="Estado" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="Compañía" name="group_company" context="{'group_by':'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>
</odoo>