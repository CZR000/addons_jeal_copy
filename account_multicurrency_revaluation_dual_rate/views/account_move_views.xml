<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_move_form" model="ir.ui.view">
            <field name="name">account.move.view.form.inherit.account_multicurrency_revaluation_dual_rate</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                    <button name="action_open_source_revaluation_move"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-file-text-o"
                            invisible="not revaluation_source_move_id">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_text">1 Source Document</span>
                        </div>
                    </button>
                    <button name="action_open_revaluation_entries"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-balance-scale"
                            invisible="revaluation_entry_count == 0">
                        <field name="revaluation_entry_count" widget="statinfo" string="Revaluation"/>
                    </button>
                </xpath>
            </field>
        </record>

    </data>
</odoo>