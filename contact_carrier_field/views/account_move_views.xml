<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_inherit_carrier" model="ir.ui.view">
        <field name="name">account.move.form.inherit.carrier</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="is_carrier" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_out_invoice_tree_inherit_carrier" model="ir.ui.view">
        <field name="name">account.move.out.invoice.tree.inherit.carrier</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="is_carrier" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_in_invoice_tree_inherit_carrier" model="ir.ui.view">
        <field name="name">account.move.in.invoice.tree.inherit.carrier</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="is_carrier" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_invoice_filter_inherit_carrier" model="ir.ui.view">
        <field name="name">account.move.search.inherit.carrier</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='status']" position="before">
                <separator/>
                <filter string="Es Transportista"
                        name="filter_is_carrier"
                        domain="[('is_carrier', '=', True)]"/>
            </xpath>
            <xpath expr="//filter[@name='partner']" position="after">
                <filter string="Es Transportista"
                        name="group_is_carrier"
                        context="{'group_by': 'is_carrier'}"/>
            </xpath>
        </field>
    </record>

</odoo>