<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_move_reject_wizard_form" model="ir.ui.view">
        <field name="name">account.move.reject.wizard.form</field>
        <field name="model">account.move.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Rechazar Asiento Contable">
                <sheet>
                    <group>
                        <field name="move_id" invisible="1"/>
                    </group>
                    <group>
                        <label for="rejection_reason" string="Motivo de Rechazo"/>
                        <field name="rejection_reason"
                               widget="text"
                               placeholder="Indique el motivo por el cual se rechaza este asiento..."
                               nolabel="1"
                               required="1"
                               options="{'rows': 5}"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_reject_move"
                            string="Rechazar"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancelar"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
