<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_journal_view_form_inherit" model="ir.ui.view">
        <field name="name">account.journal.form.inherit.approval</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='advanced_settings']/group" position="inside">
                <group name="approval_settings" string="Configuración de Aprobación">
                    <field name="requires_approval"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
